# Development image with hot reload.
# glibc (Debian slim), not Alpine: @libsql/client ships a glibc native binding.
FROM oven/bun:1-slim

WORKDIR /app

COPY package.json bun.lock* ./
RUN bun install --frozen-lockfile

COPY . .

EXPOSE 3000 24678

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD bun -e "fetch('http://localhost:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# Apply migrations to the local file database, then start the dev server.
CMD ["sh", "-c", "mkdir -p .data && bun run db:migrate && bun run dev --host 0.0.0.0"]
