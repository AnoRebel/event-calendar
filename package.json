{
  "name": "event-calendar",
  "description": "A somewhat configurable modular calendar with some integrations",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:analyze": "nuxt build --analyze",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "bunx eslint .",
    "lint:fix": "bunx eslint . --fix",
    "format": "bunx prettier --write .",
    "format:write": "bunx prettier --write \"**/*.{ts,vue,mdx}\" --cache",
    "format:check": "bunx prettier --check \"**/*.{ts,vue,mdx}\" --cache",
    "typecheck": "nuxt typecheck",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest --coverage",
    "test:e2e": "bun test e2e/",
    "registry:build": "bunx shadcn-vue@latest build --output public/r && bun run registry:rewrite-url",
    "registry:rewrite-url": "bun -e \"const host=process.env.REGISTRY_HOST||'https://event-calendar.anorebel.net'; const fs=require('fs'); for(const f of fs.readdirSync('public/r')){ if(!f.endsWith('.json'))continue; const p='public/r/'+f; fs.writeFileSync(p, fs.readFileSync(p,'utf8').replaceAll('https://REGISTRY_URL', host)); } console.log('rewrote REGISTRY_URL -> '+host);\"",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate",
    "db:push": "bun --bun drizzle-kit push",
    "db:studio": "bun --bun drizzle-kit studio",
    "db:seed": "bun --bun scripts/seed.ts",
    "security:audit": "npm audit --audit-level moderate",
    "security:fix": "npm audit fix",
    "deploy": "bash scripts/deploy.sh",
    "deploy:rollback": "bash scripts/deploy.sh rollback",
    "health-check": "bash scripts/deploy.sh health-check",
    "docker:build": "docker build -t event-calendar .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "performance:audit": "lighthouse http://localhost:3000 --output=html",
    "sw:generate": "workbox generateSW workbox-config.js"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@libsql/client": "^0.17.4",
    "@nuxt/eslint": "1.16.0",
    "@nuxt/icon": "2.3.1",
    "@nuxt/image": "2.0.0",
    "@nuxt/scripts": "1.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-form": "^1.33.2",
    "@unhead/vue": "^3.1.8",
    "@vue-dnd-kit/core": "^2.4.7",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.7.0",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.4.8",
    "nuxt-auth-utils": "^0.5.29",
    "nuxt-authorization": "^0.3.5",
    "nuxt-umami": "3.2.1",
    "reka-ui": "^2.10.1",
    "shadcn-nuxt": "2.8.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.1",
    "vue-sonner": "^2.0.9"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@tailwindcss/oxide",
    "esbuild",
    "sharp",
    "unrs-resolver",
    "vue-demi"
  ],
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.117",
    "@types/node": "^26.1.1",
    "@types/uuid": "^11.0.0",
    "@vitest/ui": "^4.1.10",
    "@vue-dnd-kit/nuxt": "^1.0.2",
    "@vue/test-utils": "^2.4.11",
    "bunwright": "^0.3.1",
    "drizzle-kit": "^0.31.10",
    "eslint-plugin-security": "^4.0.1",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.4.0",
    "prettier": "^3.9.5",
    "semver": "^7.8.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7",
    "workbox-cli": "^7.4.1"
  }
}
