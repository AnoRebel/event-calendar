# Event Calendar configuration. Copy to .env and fill in what you need.
# Every variable the app reads is listed here; nothing else is used.
#
# Runtime variables (NUXT_*) can change without a rebuild. Build-time variables
# (FEATURE_*, OPEN_REGISTRATION, DEMO_MODE, NUXT_UMAMI_SITE_ID, NUXT_RYBBIT_SITE_ID)
# only set defaults when `bun run build` runs.

# --- Secrets -----------------------------------------------------------------
# Nuxt's root secret; the session cookie is sealed with a key derived from it.
# REQUIRED in production (at least 32 characters); development generates one.
#   openssl rand -base64 32
NUXT_APP_SECRET=

# --- Database (libSQL) ---------------------------------------------------------
# Defaults to the local file file:./.data/events.db.
# Self-hosted sqld without auth: http://host:8080. Turso: libsql://… plus a token.
LIBSQL_URL=
LIBSQL_AUTH_TOKEN=

# --- Registration ------------------------------------------------------------------
# Default: invite-only. The first account on an empty database registers freely;
# after that a signed-in user creates invite links from the Account page.
# true lets anyone register.  (Build-time default: OPEN_REGISTRATION)
NUXT_OPEN_REGISTRATION=false

# --- Demo mode ------------------------------------------------------------------------
# A shared, one-click demo account with sample events, reset daily at midnight.
# (Build-time default: DEMO_MODE; DEMO_EMAIL / DEMO_PASSWORD likewise)
NUXT_DEMO_ENABLED=false
# NUXT_DEMO_EMAIL=demo@event-calendar.app
# NUXT_DEMO_PASSWORD=demo-calendar-1234

# --- Feature flags (default off) --------------------------------------------------------
# Build-time default: FEATURE_RECURRING_EVENTS / FEATURE_COLLABORATION
# Runtime override:   NUXT_PUBLIC_FEATURES_RECURRING_EVENTS / NUXT_PUBLIC_FEATURES_COLLABORATION
FEATURE_RECURRING_EVENTS=false
FEATURE_COLLABORATION=false

# --- Analytics (optional) ----------------------------------------------------------------
# Site ids are baked in at BUILD time; setting them only at runtime does nothing.
NUXT_UMAMI_SITE_ID=
NUXT_RYBBIT_SITE_ID=
# false disables both trackers.
NUXT_PUBLIC_ENABLE_ANALYTICS=true

# --- Server -----------------------------------------------------------------------------
# PORT=3000
# HOST=0.0.0.0
