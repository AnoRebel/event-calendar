# Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# This lists ONLY the variables the app actually reads.

# Application Environment
NODE_ENV=production

# API base path (client)
NUXT_PUBLIC_API_BASE=/api

# Database (libSQL / Turso)
# Self-hosted sqld without auth: set only LIBSQL_URL (http://host:port).
# Turso cloud or JWT-protected sqld: set both.
# Local dev falls back to a file DB (file:./.data/events.db) when unset.
LIBSQL_URL=
LIBSQL_AUTH_TOKEN=

# Security
# NUXT_SESSION_PASSWORD seals the auth session cookie — REQUIRED, min 32 chars.
# Production startup refuses to boot without a strong value. Generate with:
#   openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# Registration policy
# Default is invite/seed-only: the FIRST account (empty DB) registers freely to
# bootstrap; after that, registration requires an invite token (created by a
# signed-in user via POST /api/invites). Override to allow open registration:
#   Runtime (no rebuild): NUXT_OPEN_REGISTRATION=true
#   Build-time default:   OPEN_REGISTRATION=true
NUXT_OPEN_REGISTRATION=false

# Analytics
# Set NUXT_PUBLIC_ENABLE_ANALYTICS=false to disable both Umami and Rybbit.
NUXT_PUBLIC_ENABLE_ANALYTICS=true
# IMPORTANT: NUXT_UMAMI_SITE_ID is read at BUILD time (nuxt-umami bakes it into
# the bundle during module setup). It MUST be present in the build environment —
# setting it only at runtime has no effect and Umami will silently track nothing.
NUXT_UMAMI_SITE_ID=
NUXT_RYBBIT_SITE_ID=

# Feature Flags (default OFF; set to "true" or "1" to enable).
#   Build-time default:   FEATURE_RECURRING_EVENTS / FEATURE_COLLABORATION
#   Runtime (no rebuild): NUXT_PUBLIC_FEATURES_RECURRING_EVENTS / NUXT_PUBLIC_FEATURES_COLLABORATION
# Recurring events: shows the recurrence UI and accepts recurring payloads.
FEATURE_RECURRING_EVENTS=false
# Collaboration: enables the real-time WebSocket sync between sessions.
FEATURE_COLLABORATION=false
